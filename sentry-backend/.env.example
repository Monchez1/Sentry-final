# ─────────────────────────────────────────────
# SENTRY Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file
# ─────────────────────────────────────────────

# PostgreSQL connection string (from Neon.tech free tier)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated list of allowed frontend origins
# Set to your Vercel URL after deploying
CORS_ORIGINS=https://your-app.vercel.app

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Exchange API credentials (set per-user via the app UI, not here)
# These are stored in the database, not env vars
